        android:strokeColor="#FAC775"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M57,59l3,-3" />
    <path
        android:fillColor="#FAC775"
        android:pathData="M57,59m-1.4,0a1.4,1.4 0 1,1 2.8,0a1.4,1.4 0 1,1 -2.8,0" />

