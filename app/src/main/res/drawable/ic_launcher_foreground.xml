        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M49,50h8c5.5,0 10,4 10,9s-4.5,9 -10,9h-8z M53,53.5h4c3.5,0 6,2.5 6,5.5s-2.5,5.5 -6,5.5h-4z" />

